# VocalMarket AI — Environment Variables
# Copy to .env and fill in values before running any service.
# Never commit .env to version control.

# ─── Enthusiast (Django backend) ───────────────────────────────────────────────
SECRET_KEY=change-me-generate-with-django-get-random-secret-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vocalmarket
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── API Gateway ───────────────────────────────────────────────────────────────
GATEWAY_JWT_SECRET=change-me-min-32-chars-random-string
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Comma-separated; no wildcards in production
GATEWAY_ENTHUSIAST_SERVICE_TOKEN=your-service-account-token
# Must match a service-account DRF token created in Django admin (is_service_account=True)

# ─── AI Orchestrator ───────────────────────────────────────────────────────────
VOCALMARKET_AI_LAYER=enthusiast
# enthusiast = V1 (direct Enthusiast), hybrid = V2 (Hermes orchestrates)

ORCHESTRATOR_ENTHUSIAST_BASE_URL=http://localhost:8000
ORCHESTRATOR_ENTHUSIAST_API_KEY=your-enthusiast-api-token

ORCHESTRATOR_MEMORY_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vocalmarket
ORCHESTRATOR_REDIS_URL=redis://localhost:6379/1

# V2 Hermes settings (only required when VOCALMARKET_AI_LAYER=hybrid)
ORCHESTRATOR_HERMES_MODEL=NousResearch/Hermes-3-Llama-3.1-8B
ORCHESTRATOR_HERMES_BASE_URL=http://localhost:8080/v1
ORCHESTRATOR_HERMES_API_KEY=

# ─── Vertical DataSet IDs (from Enthusiast admin) ──────────────────────────────
VOCALMARKET_GROCERY_DATA_SET_ID=1
VOCALMARKET_GROCERY_PRODUCT_SEARCH_AGENT_ID=1
VOCALMARKET_GROCERY_ORDER_INTAKE_AGENT_ID=2
VOCALMARKET_B2B_DATA_SET_ID=2
VOCALMARKET_HEALTHCARE_DATA_SET_ID=3

# ─── Voice Service ─────────────────────────────────────────────────────────────
VOICE_WHISPER_BASE_URL=http://localhost:9000
VOICE_ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID_ZA=21m00Tcm4TlvDq8ikWAM

# ─── ForgePay Payments ─────────────────────────────────────────────────────────
FORGEPAY_API_KEY=your-forgepay-api-key
FORGEPAY_WEBHOOK_SECRET=your-forgepay-webhook-secret

# ─── Medusa Commerce ───────────────────────────────────────────────────────────
MEDUSA_API_KEY=your-medusa-admin-api-key
MEDUSA_ADMIN_CORS=http://localhost:7001
STORE_CORS=http://localhost:8080
COOKIE_SECRET=change-me-min-32-chars-random-string

# ─── Healthcare (POPIA compliance) ─────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HEALTHCARE_PRESCRIPTION_ENCRYPTION_KEY=

# ─── Database (shared by multiple services) ────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vocalmarket

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-min-32-chars-random-string
# Must match GATEWAY_JWT_SECRET above

# ─── Intelligence Service ──────────────────────────────────────────────────────
# OpenAI key for pgvector semantic embeddings in supplier discovery. Leave blank for keyword fallback.
INTELLIGENCE_OPENAI_API_KEY=
INTELLIGENCE_EMBEDDING_MODEL=text-embedding-3-small

# ─── Analytics Service (Sprint 4 — Bloomberg data model) ───────────────────────
# Comma-separated API keys for paying analytics customers. Leave blank for open access in dev.
ANALYTICS_API_KEYS=
ANALYTICS_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vocalmarket

# ─── Geography / Multi-market ──────────────────────────────────────────────────
# Per-market ElevenLabs voice IDs (defaults match GeographyConfig constants)
VOCALMARKET_ELEVENLABS_VOICE_ID_ZA=21m00Tcm4TlvDq8ikWAM
VOCALMARKET_ELEVENLABS_VOICE_ID_IN=AZnzlk1XvdvUeBnXmlld
VOCALMARKET_ELEVENLABS_VOICE_ID_US=EXAVITQu4vr4xnSDxMaL
VOCALMARKET_ELEVENLABS_VOICE_ID_EU=ThT5KcBeYPX3keUQqHPh

# ─── OpenTelemetry ─────────────────────────────────────────────────────────────
TEMPO_ENDPOINT=http://localhost:4317

# ─── Messaging Service (omnichannel: Telegram, WhatsApp, SMS, Slack, Teams, USSD) ──
# Each channel self-enables when its credentials are present. Open the console at
# http://localhost:8006/console to see live status + the webhook URL to register.
MESSAGING_PUBLIC_BASE_URL=http://localhost:8006
MESSAGING_DEFAULT_VERTICAL=grocery

# Telegram — create a bot via @BotFather, set a random webhook secret
MESSAGING_TELEGRAM_BOT_TOKEN=
MESSAGING_TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Business — Meta Cloud API (Meta App dashboard → WhatsApp)
MESSAGING_WHATSAPP_ACCESS_TOKEN=
MESSAGING_WHATSAPP_PHONE_NUMBER_ID=
MESSAGING_WHATSAPP_APP_SECRET=
MESSAGING_WHATSAPP_VERIFY_TOKEN=

# SMS — Twilio (Console → Phone Numbers → Messaging webhook)
MESSAGING_TWILIO_ACCOUNT_SID=
MESSAGING_TWILIO_AUTH_TOKEN=
MESSAGING_TWILIO_FROM_NUMBER=

# Slack — app with Event Subscriptions + Slash Commands
MESSAGING_SLACK_BOT_TOKEN=
MESSAGING_SLACK_SIGNING_SECRET=

# Microsoft Teams — Azure Bot registration
MESSAGING_TEAMS_APP_ID=
MESSAGING_TEAMS_APP_PASSWORD=
MESSAGING_TEAMS_INBOUND_SECRET=

# USSD — Africa's Talking (feature-phone access; no credentials, set your service code)
MESSAGING_USSD_SERVICE_CODE=*384*9000#
